[{"data":1,"prerenderedAt":543},["ShallowReactive",2],{"gql:data:TouCzivKwNtF9ORmmnPsaCqcEJSqH65jz-3_MaMMgis":3},{"teamMember":4},{"abbreviatedTitle":5,"bio":6,"image":7,"highlightStatement":9,"companies":18,"derivedSeoDescription":10,"derivedSeoTitle":274,"derivedSocialMediaDescription":10,"derivedSocialMediaImage":10,"derivedSocialMediaTitle":274,"emailAddress":275,"firstName":276,"focusAreas":277,"fullName":278,"fullTitle":5,"introduction":279,"lastName":280,"linkedinProfileUrl":281,"substackProfileUrl":9,"slug":282,"teamHighlights":283,"testimonials":296,"contentPosts":297,"twitterProfielUrl":9},"Advisory Partner","I was born in the Midwest but raised in California, where I was fortunate to be exposed to venture investing while I was still in my formative years. After spending a few very cold winters in New Hampshire and graduating from Dartmouth College with a liberal arts degree, I couldn’t wait to head back to the West Coast to start my first real job at a technology-focused investment bank in San Francisco, helping to take the early “Internet 1.0” generation of client-server software and consumer internet companies public. This exposure to mission-driven entrepreneurs had a huge and immediate impact on my career. I loved working with visionary tech leaders—people creating products with the potential to actually change the world. From day one, I was hooked. \r\n\r\nYears later, I’m still hooked. I’ve had the great fortune to work with numerous industry-defining companies and entrepreneurs. At IVP, I’ve led 18 investments and been involved in more than a dozen others. Over the last 10 to 15 years, I’ve shifted my primary investment focus from enterprise software to companies that focus on improving the quality of people’s daily lives. I’m eager to continue my work with founders who possess the rare combination of confidence, humility and passion.",{"id":8,"alt":9,"caption":10,"assetUrl":11,"assetUrlXs":12,"assetUrlSm":13,"assetUrlMd":14,"assetUrlLg":15,"assetU