[{"data":1,"prerenderedAt":61},["ShallowReactive",2],{"gql:data:t4KUe8eb4hAXQIHxMaziDOr1lYmfi_J6nPvJhd_9Dy4":3},{"company":4},{"colorFill":5,"transparentLogo":6,"logoBackground":6,"attribution":7,"body":8,"derivedSeoDescription":9,"derivedSeoTitle":10,"derivedSocialMediaDescription":9,"derivedSocialMediaImage":6,"derivedSocialMediaTitle":11,"description":7,"headline":12,"image":13,"introduction":7,"investmentDate":15,"jobLinkUrl":16,"ctaLinkUrl":17,"ctaLinkText":18,"leadership":19,"linkUrl":20,"linkText":21,"linkedinLinkUrl":22,"logo":23,"moments":32,"name":33,"quote":7,"seoDescription":9,"seoTitle":10,"slug":34,"socialMediaDescription":7,"socialMediaImage":35,"socialMediaTitle":11,"status":37,"teamMembers":40,"tileHoverImage":50,"twittterLinkUrl":59,"websiteUrl":60},"#000000",null,"","Application programming interfaces (APIs) enable communication between software, forming an invisible backbone that connects millions of applications online. While critical to millions of businesses, APIs are also especially vulnerable to cybersecurity attacks. Unfortunately, few cybersecurity solutions are sophisticated enough to protect companies from this type of attack, and most companies are unaware when their security has been compromised.\r\n\r\nThankfully, there’s Traceable, the surefire defense against API hacks. The next-gen SaaS platform tracks all APIs and their data for an entire organization, quickly recognizing when an API’s security has been breached. Unlike competitors, Traceable analyzes user behavior and business logic in real-time to ensure that sensitive information remains uncompromised. While the battle to ensure cybersecurity is a relentless one, we believe the Traceable team is in the ideal position to adapt and pioneer new solutions to safeguard enterprise data.","Traceable is the surefire defense against API hacks, analyzing user behavior and business logic in real-time so sensitive information isn't compromised.","Traceable - IVP Portfolio - Investors in Next-Gen Cybersecurity","Traceable - IVP Portfolio ","API security for cloud-native apps",{"id":14,"alt":7,"caption":6,"assetUrl":6,"assetUrlXs":6,"assetUrlSm":6,"assetUrlMd":6,"assetUrlLg":6,"assetUrlXl":6,"assetUrlXxl":6},"595","2022-05-03","https://careers.ivp.com/companydetail.php?cid=25033&v=5","/portfolio/harness/","Learn more about Harness","Jyoti Bansal","/content/traceable-ai-a-revolutionary-approach-to-api-security/","Read the Funding Announcement","https://www.linkedin.com/company/traceable-ai/",{"id":24,"alt":7,"caption":6,"assetUrl":25,"assetUrlXs":26,"assetUrlSm":27,"assetUrlMd":28,"assetUrlLg":29,"assetUrlXl":30,"assetUrlXxl":31},"597","https://assets.ivp.com/system/uploads/fae/image/asset/597/Traceable_ai.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/597/xs_Traceable_ai.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/597/sm_Traceable_ai.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/597/md_Traceable_ai.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/597/lg_Traceable_ai.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/597/xl_Traceable_ai.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/597/xxl_Traceable_ai.jpg","Founded 2018\r\nPartnered 2022\r\nAcquired by Harness 2025","Traceable","traceable",{"id":36,"alt":7,"caption":6,"assetUrl":6,"assetUrlXs":6,"assetUrlSm":6,"assetUrlMd":6,"assetUrlLg":6,"assetUrlXl":6,"assetUrlXxl":6},"594",{"name":38,"slug":39},"Active","active",[41,44,47],{"fullName":42,"slug":43},"Somesh Dash","somesh-dash",{"fullName":45,"slug":46},"Steve Harrick","steve-harrick",{"fullName":48,"slug":49},"Shreyas Garg","shreyas-garg",{"id":51,"alt":7,"caption":6,"assetUrl":52,"assetUrlXs":53,"assetUrlSm":54,"assetUrlMd":55,"assetUrlLg":56,"assetUrlXl":57,"assetUrlXxl":58},"596","https://assets.ivp.com/system/uploads/fae/image/asset/596/Traceable_ai.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/596/xs_Traceable_ai.jpg","https://assets.ivp.com/system/upload