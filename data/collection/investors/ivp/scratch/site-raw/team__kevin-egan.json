[{"data":1,"prerenderedAt":181},["ShallowReactive",2],{"gql:data:Ow7OUjnKK0cVKjH5FMqI_IFnYDZ6ZxzaZJSIFh-zCW8":3},{"teamMember":4},{"abbreviatedTitle":5,"bio":6,"image":7,"highlightStatement":5,"companies":17,"derivedSeoDescription":9,"derivedSeoTitle":114,"derivedSocialMediaDescription":9,"derivedSocialMediaImage":9,"derivedSocialMediaTitle":114,"emailAddress":115,"firstName":116,"focusAreas":117,"fullName":118,"fullTitle":119,"introduction":5,"lastName":120,"linkedinProfileUrl":121,"substackProfileUrl":5,"slug":122,"teamHighlights":123,"testimonials":142,"contentPosts":143,"twitterProfielUrl":5},"","Today, I lead sales as CRO at ClickHouse, helping the team accelerate adoption, scale the organization, and build lasting customer relationships. I continue to support IVP as a Venture Partner, working closely with founders on go-to-market strategy and executive hiring. What drew me to IVP was not just the people—Ajay, Somesh, and Jules, whom I’ve known for over a decade—but also the partnership structure. We operate as a team, without a “single name on the door,” ensuring that every company we work with has access to the collective expertise, support, and commitment needed to scale their company.\r\n\r\nI love working with entrepreneurs who are disruptive, determined, and focused—those with a bold vision and a sharp eye for the details. The most successful leaders understand that they alone are not scalable, that they require greatness around them to realize their goals. I’m at my best when helping hire talent for near-term needs and future demands or optimizing the intersection between product-led growth and high-touch sales. I’m passionate about helping entrepreneurs navigate it all, empowering them to make decisions that shape the future of their companies and their industries for the better. ",{"id":8,"alt":5,"caption":9,"assetUrl":10,"assetUrlXs":11,"assetUrlSm":12,"assetUrlMd":13,"assetUrlLg":14,"assetUrlXl":15,"assetUrlXxl":16},"2369",null,"https://assets.ivp.co