[{"data":1,"prerenderedAt":272},["ShallowReactive",2],{"gql:data:Z0_zVXXTGxt96NbE1ZfdM2bd9TpuKNJUHdFwXmVIkoE":3},{"contentPost":4},{"landscapeHero":5,"altHoverImage":5,"company":5,"companies":6,"contentCategory":7,"hideDate":20,"date":21,"otherAuthors":10,"derivedSeoDescription":5,"derivedSeoTitle":22,"derivedSocialMediaDescription":5,"derivedSocialMediaImage":23,"derivedSocialMediaTitle":22,"externalLinkUrl":10,"featuredExcerpt":10,"hasDetailPage":5,"heroImage":32,"pageComponents":41,"pdfUpload":256,"pdfFile":258,"pdfFileLinkLabel":10,"relatedContentPosts":259,"slug":260,"teamMembers":261,"tileImage":262,"title":271},null,[],{"contentTopicImage":8,"name":18,"slug":19},{"id":9,"alt":10,"caption":5,"assetUrl":11,"assetUrlXs":12,"assetUrlSm":13,"assetUrlMd":14,"assetUrlLg":15,"assetUrlXl":16,"assetUrlXxl":17},"2405","","https://assets.ivp.com/system/uploads/fae/image/asset/2405/IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/xs_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/sm_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/md_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/lg_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/xl_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/xxl_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","Industry Insight","industry-insight",false,"2024-10-23","Undaunted: CEOs Navigate the Present and Shape the Future | IVP",{"id":24,"alt":10,"caption":5,"assetUrl":25,"assetUrlXs":26,"assetUrlSm":27,"assetUrlMd":28,"assetUrlLg":29,"assetUrlXl":30,"assetUrlXxl":31},"1698","https://assets.ivp.com/system/uploads/fae/image/asset/1698/Undaunted_Social_Image.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1698/xs_Undaunted_Social_Image.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1698/sm_Undaunted_Social_Image.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1698/md_Undaunted_Social_Image.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1698/lg_Undaunted_Social_Image.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1698/xl_Undaunted_Social_Image.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1698/xxl_Undaunted_Social_Image.jpg",{"id":33,"alt":10,"caption":10,"assetUrl":34,"assetUrlXs":35,"assetUrlSm":36,"assetUrlMd":37,"assetUrlLg":38,"assetUrlXl":39,"assetUrlXxl":40},"1700","https://assets.ivp.com/system/uploads/fae/image/asset/1700/Undaunted_Blog_Image_1.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1700/xs_Undaunted_Blog_Image_1.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1700/sm_Undaunted_Blog_Image_1.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1700/md_Undaunted_Blog_Image_1.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1700/lg_Undaunted_Blog_Image_1.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1700/xl_Undaunted_Blog_Image_1.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1700/xxl_Undaunted_Blog_Image_1.jpg",[42,46,58,69,80,91,102,113,124,135,146,157,168,179,190,201,212,223,234,245],{"instance":43},{"__typename":44,"largeHeading":10,"heading":10,"body":45},"TextBlock","Leading a remarkable company means envisioning the future while driving results now.\r\n\r\nAt our CEO gathering, Undaunted 2024, CEOs swapped hard-earned wisdom on building product, team and the future.  Here is a selection of what was shared:\r\n\r\n“Work backward from the future you want to create,” declared HubSpot’s [Yamini Rangan](https://www.linkedin.com/in/yaminirangan/). With AI accelerating product development, annual planning is too slow—teams need to operate in 3-6 month sprints to stay ahead.\r\n\r\n“As a founder-CEO, you have the unique ability to navigate all levels of the company. Put your ear to the ground and stay connected to your team.” [George Kurtz](https://www.linkedin.com/in/georgekurtz/?lipi=urn%3Ali%3Apage%3Ad_flagship3_detail_base%3B1l0iLvlzR6aSs5vLtsrT0w%3D%3D) encouraged CEOs to leverage their unique position to stay in touch with every layer of their organization.\r\n\r\n“If you’ve got 5 gears, what’s the point of being in 2nd?” asked former NFL wide receiver and investor [Larry Fitzgerald Jr.](https://www.linkedin.com/in/larryfitzgeraldjr/), who pushes to the highest level of performance, both in business and on the field.\r\n\r\n“High alignment brings high autonomy.” [Liz Hamren](https://www.linkedin.com/in/elizbas/) fosters cohesion as CEO of Ring by prioritizing 1:1s, monthly town halls and weekly topics meetings.\r\n\r\n“Product market fit is dead in this environment.” Rubrik’s [Bipul Sinha](https://www.linkedin.com/in/bipulsinha/) believes finding PMF is no longer a one-time achievement but a constant pursuit, to be reevaluated every 6-9 months.\r\n\r\n“Build startups within your startup,” Harness and Traceable CEO, [Jyoti Bansal](https://www.linkedin.com/in/jyotibansal/), insists that each new product be run like a seed-stage startup with a mini CEO, allocating engineering resources as it reaches new benchmarks, just like a Series A or B investor would.\r\n\r\n“Talent is your ONLY differentiator” and should always be your #1 operating priority. [Emilie Choi](https://www.linkedin.com/in/emiliechoi/) said she and Brian still approve every new Coinbase hire.\r\n\r\n“Two things are true as CEO: 1. You’re going to live in a constant state of conflict AND 2. It’s important along the way to acknowledge the moments where you internalize just how special this journey is.” HashiCorp’s [David McJannet](https://www.linkedin.com/in/dmcjannet/) recommends savoring the moments that go well.\r\n\r\n“Just make the call.” [Kevin Weil](https://www.linkedin.com/in/kevinweil/) shared that OpenAI has a refreshing lack of respect for the org traditional chart. Instead of asking someone who will ask someone to do it, they get it done regardless.\r\n\r\nStrength for CEOs means something different to each individual. Strength = embracing discomfort, vulnerability, creativity, authenticity, the 5th gear, NOW and so much more. Below are a few moments that capture Undaunted 2024.",{"instance":47},{"__typename":48,"heading":10,"image":49},"FullImage",{"id":50,"alt":10,"caption":10,"assetUrl":51,"assetUrlXs":52,"assetUrlSm":53,"assetUrlMd":54,"assetUrlLg":55,"assetUrlXl":56,"assetUrlXxl":57},"1707","https://assets.ivp.com/system/uploads/fae/image/asset/1707/Blog_-_Cack_Undaunted.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1707/xs_Blog_-_Cack_Undaunted.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1707/sm_Blog_-_Cack_Undaunted.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1707/md_Blog_-_Cack_Undaunted.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1707/lg_Blog_-_Cack_Undaunted.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1707/xl_Blog_-_Cack_Undaunted.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1707/xxl_Blog_-_Cack_Undaunted.jpg",{"instance":59},{"__typename":48,"heading":10,"image":60},{"id":61,"alt":10,"caption":10,"assetUrl":62,"assetUrlXs":63,"assetUrlSm":64,"assetUrlMd":65,"assetUrlLg":66,"assetUrlXl":67,"assetUrlXxl":68},"1704","https://assets.ivp.com/system/uploads/fae/image/asset/1704/Blog_-_Archery.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1704/xs_Blog_-_Archery.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1704/sm_Blog_-_Archery.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1704/md_Blog_-_Archery.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1704/lg_Blog_-_Archery.jpg","https://assets.ivp.com/system/uploads/fae/ima