[{"data":1,"prerenderedAt":283},["ShallowReactive",2],{"gql:data:zzyU-mgRUMw8wFpjBf41QUFKXXSF9KKq7P3Va02YM_0":3},{"contentPost":4},{"landscapeHero":5,"altHoverImage":5,"company":5,"companies":6,"contentCategory":7,"hideDate":20,"date":21,"otherAuthors":10,"derivedSeoDescription":5,"derivedSeoTitle":22,"derivedSocialMediaDescription":5,"derivedSocialMediaImage":23,"derivedSocialMediaTitle":22,"externalLinkUrl":10,"featuredExcerpt":10,"hasDetailPage":5,"heroImage":32,"pageComponents":41,"pdfUpload":267,"pdfFile":269,"pdfFileLinkLabel":10,"relatedContentPosts":270,"slug":271,"teamMembers":272,"tileImage":273,"title":282},null,[],{"contentTopicImage":8,"name":18,"slug":19},{"id":9,"alt":10,"caption":5,"assetUrl":11,"assetUrlXs":12,"assetUrlSm":13,"assetUrlMd":14,"assetUrlLg":15,"assetUrlXl":16,"assetUrlXxl":17},"2405","","https://assets.ivp.com/system/uploads/fae/image/asset/2405/IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/xs_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/sm_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/md_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/lg_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/xl_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2405/xxl_IVP_jumpGuide_IndustryInsights_042026_Industry_Insight.jpg","Industry Insight","industry-insight",false,"2023-10-16","IVP AI CEO Summit",{"id":24,"alt":10,"caption":5,"assetUrl":25,"assetUrlXs":26,"assetUrlSm":27,"assetUrlMd":28,"assetUrlLg":29,"assetUrlXl":30,"assetUrlXxl":31},"1396","https://assets.ivp.com/system/uploads/fae/image/asset/1396/V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1396/xs_V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1396/sm_V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1396/md_V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1396/lg_V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1396/xl_V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1396/xxl_V1.png",{"id":33,"alt":10,"caption":10,"assetUrl":34,"assetUrlXs":35,"assetUrlSm":36,"assetUrlMd":37,"assetUrlLg":38,"assetUrlXl":39,"assetUrlXxl":40},"1398","https://assets.ivp.com/system/uploads/fae/image/asset/1398/V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1398/xs_V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1398/sm_V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1398/md_V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1398/lg_V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1398/xl_V1.png","https://assets.ivp.com/system/uploads/fae/image/asset/1398/xxl_V1.png",[42,46,58,69,80,91,102,113,124,135,146,157,168,179,190,201,212,223,234,245,256],{"instance":43},{"__typename":44,"largeHeading":10,"heading":10,"body":45},"TextBlock","AI is advancing at warp speed. To help chart the future, IVP convened the brightest AI thinkers, leaders and CEOs for an offsite immersion, with candid talks, deep conversation and impactful connections. Here is a glimpse of insights shared amongst the group:\r\n\r\n* Andre Iguodala, in conversation with the similarly inimitable Arianna Huffington, demystified how his daily habits help drive his peak performance. He prioritizes sleep “to fix problems faster” and strives to be 1% better every day. \r\n* Shrewd banter from former colleagues Ajay Vashee and Brad Lightcap about OpenAI’s charter and perspective on the future.\r\n* Shantanu Narayen revealed to Tamar Yehoshua a secret for cultivating innovation at Adobe throughout his nearly 16 years as CEO: identify your company’s superstars and clear the way so they can focus on their passions- and they’ll work 10x harder.\r\n* Carnegie Endowment’s Dr. Tino Cuéllar reflected on the geopolitical ramifications of AI regulation and which nations have the first-mover advantage, with Somesh Dash.\r\n* Databricks CEO Ali Ghodsi and Cack Wilhelm bonded over what it REALLY takes to go from $1M to $1B ARR. Ali credits growth in part to their intense culture - energizing the company with a vision that makes everyone’s hair stand up, inspecting individual KPIs outside of your direct reports and maintaining a sprinter’s pace with 4p Friday exec meetings.\r\n* We capped off with a human-AI collaboration, the [Generative Gospel](https://assets.ivp.com/system/uploads/fae/file/asset/357/IVP_CEO_Meet-Up_A_Generative_Gospel.pdf), a poem woven from the conversations and considerations at the summit, dreamt up by Hakim Bellamy with assistance from AI.\r\n\r\nThank you to our guests for an open and perceptive look at what’s next. Enjoy a deeper look into the summit, in pictures, below.",{"instance":47},{"__typename":48,"heading":10,"image":49},"FullImage",{"id":50,"alt":10,"caption":10,"assetUrl":51,"assetUrlXs":52,"assetUrlSm":53,"assetUrlMd":54,"assetUrlLg":55,"assetUrlXl":56,"assetUrlXxl":57},"1399","https://assets.ivp.com/system/uploads/fae/image/asset/1399/Copy_of_MC3_8443_websize.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1399/xs_Copy_of_MC3_8443_websize.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1399/sm_Copy_of_MC3_8443_websize.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1399/md_Copy_of_MC3_8443_websize.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1399/lg_Copy_of_MC3_8443_websize.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1399/xl_Copy_of_MC3_8443_websize.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/1399/xxl_Copy_of_MC3_8443_websize.jpg",{"instance":59},{"__typename":48,"heading":10,"image":60},{"id":61