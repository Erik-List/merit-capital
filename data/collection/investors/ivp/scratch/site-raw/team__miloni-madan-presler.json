[{"data":1,"prerenderedAt":241},["ShallowReactive",2],{"gql:data:MohPSD67IIbozyujvQcIXS2CX9wtS7aMlWg3NvJbV4c":3},{"teamMember":4},{"abbreviatedTitle":5,"bio":6,"image":7,"highlightStatement":5,"companies":17,"derivedSeoDescription":9,"derivedSeoTitle":83,"derivedSocialMediaDescription":9,"derivedSocialMediaImage":9,"derivedSocialMediaTitle":83,"emailAddress":84,"firstName":85,"focusAreas":86,"fullName":87,"fullTitle":88,"introduction":5,"lastName":89,"linkedinProfileUrl":90,"substackProfileUrl":5,"slug":91,"teamHighlights":92,"testimonials":108,"contentPosts":109,"twitterProfielUrl":5},"","Growth investing is one of the few fields where you’re consistently at the forefront of innovation, witnessing progress firsthand. With technology constantly evolving, there’s always something new to learn and discover. This excitement is what initially drew me to investing, but it’s the profound and positive impact—how these companies transform entire industries for the better—that continues to keep me deeply engaged.\r\n\r\nBreakthrough growth goes beyond strategy; it’s about commitment, connections, and character. The most successful founders and CEOs prioritize people, genuinely understand their customers, and are obsessed with delivering the best possible outcomes. They wake up every day focused on how to improve their solutions, and working alongside them is what makes my work meaningful. \r\n\r\nI’m passionate about partnering with businesses that aren’t just innovating for the sake of it but are solving real problems—creating products and solutions people truly need, not just want. These companies bridge gaps in fragmented ecosystems, automate outdated processes, and deliver data-driven platforms that can transform industries. These companies and their impact will endure long beyond our involvement, and the opportunity to help drive that lasting change is what keeps me inspired and intentional about all that I do.",{"id":8,"alt":5,"caption":9,"assetUrl":10,"assetUrlXs":11,