[{"data":1,"prerenderedAt":70},["ShallowReactive",2],{"gql:data:FbSoM3lvYbSm1qII5q3A4KCBwe9E9D-DIpH7RUI8hLk":3},{"company":4},{"colorFill":5,"transparentLogo":6,"logoBackground":17,"attribution":8,"body":19,"derivedSeoDescription":20,"derivedSeoTitle":21,"derivedSocialMediaDescription":20,"derivedSocialMediaImage":9,"derivedSocialMediaTitle":22,"description":8,"headline":23,"image":24,"introduction":8,"investmentDate":26,"jobLinkUrl":27,"ctaLinkUrl":8,"ctaLinkText":8,"leadership":28,"linkUrl":29,"linkText":30,"linkedinLinkUrl":31,"logo":32,"moments":41,"name":42,"quote":8,"seoDescription":20,"seoTitle":21,"slug":43,"socialMediaDescription":8,"socialMediaImage":44,"socialMediaTitle":22,"status":46,"teamMembers":49,"tileHoverImage":59,"twittterLinkUrl":68,"websiteUrl":69},"#0F0FE1",{"id":7,"alt":8,"caption":9,"assetUrl":10,"assetUrlXs":11,"assetUrlSm":12,"assetUrlMd":13,"assetUrlLg":14,"assetUrlXl":15,"assetUrlXxl":16},"2193","",null,"https://assets.ivp.com/system/uploads/fae/image/asset/2193/IVP_PortCo_Logos_520px_032626_Paper.png","https://assets.ivp.com/system/uploads/fae/image/asset/2193/xs_IVP_PortCo_Logos_520px_032626_Paper.png","https://assets.ivp.com/system/uploads/fae/image/asset/2193/sm_IVP_PortCo_Logos_520px_032626_Paper.png","https://assets.ivp.com/system/uploads/fae/image/asset/2193/md_IVP_PortCo_Logos_520px_032626_Paper.png","https://assets.ivp.com/system/uploads/fae/image/asset/2193/lg_IVP_PortCo_Logos_520px_032626_Paper.png","https://assets.ivp.com/system/uploads/fae/image/asset/2193/xl_IVP_PortCo_Logos_520px_032626_Paper.png","https://assets.ivp.com/system/uploads/fae/image/asset/2193/xxl_IVP_PortCo_Logos_520px_032626_Paper.png",{"id":18,"alt":8,"caption":9,"assetUrl":9,"assetUrlXs":9,"assetUrlSm":9,"assetUrlMd":9,"assetUrlLg":9,"assetUrlXl":9,"assetUrlXxl":9},"2194","Throughout his teaching career, Phil Cutler noticed that students who sought after-school tutoring services typically came from affluent families, while many of those who struggled the most could not afford extracurricular help. In an effort to combat this inequity, Phil founded Paper to improve access and outcomes for all students regardless of any barriers they might face, including socio-economic, geographic, linguistic and more.\r\n\r\nPaper is now the leading B2B educational support system and provider of high-dosage tutoring for K-12 school districts across North America. Purchased at the district or site level, Paper ensures that support for students is truly equitable, scalable and cost-effective. The fast-growing edtech platform provides unlimited one-on-one support 24/7, and offers both live and asynchronous tutoring in 200+ subject areas in four languages. Districts that have adopted Paper are receiving rave reviews from students, teachers and parents—with some students even crediting Paper with their successful admission to college. We are thrilled to partner with Paper to improve educational access in schools everywhere.","Paper provides the students of K-12 school districts across North America with live and asynchronous tutoring in 200+ subject areas across four languages.","Paper - IVP Portfolio - Market-Leading Edtech Investors","Paper - IVP Portfolio  ","The leading software provider of 24/7 high dosage tutoring",{"id":25,"alt":8,"caption":9,"assetUrl":9,"assetUrlXs":9,"assetUrlSm":9,"assetUrlMd":9,"assetUrlLg":9,"assetUrlXl":9,"assetUrlXxl":9},"475","2021-01-01","https://careers.ivp.com/companydetail.php?cid=23490&v=15","Philip Cutler","/content/paper-the-a-platform-for-transforming-education/","Read the Funding Announcement","https://www.linkedin.com/company/paperlearning/",{"id":33,"alt":8,"caption":9,"assetUrl":34,"assetUrlXs":35,"assetUrlSm":36,"assetUrlMd":37,"assetUrlLg":38,"assetUrlXl":39,"assetUrlXxl":40},"477","https://assets.ivp.com/system/uploads/fae/image/asset/477/Paper.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/477/xs_Paper.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/477/sm_Paper.jpg