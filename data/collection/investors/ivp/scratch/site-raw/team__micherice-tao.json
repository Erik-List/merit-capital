[{"data":1,"prerenderedAt":354},["ShallowReactive",2],{"gql:data:iEGDZQc7TgG7Dr9kUfHuIztRR24h1HUFFL6ig8BDOzc":3},{"teamMember":4},{"abbreviatedTitle":5,"bio":6,"image":7,"highlightStatement":9,"companies":18,"derivedSeoDescription":10,"derivedSeoTitle":277,"derivedSocialMediaDescription":10,"derivedSocialMediaImage":10,"derivedSocialMediaTitle":277,"emailAddress":278,"firstName":279,"focusAreas":280,"fullName":281,"fullTitle":5,"introduction":9,"lastName":282,"linkedinProfileUrl":283,"substackProfileUrl":9,"slug":284,"teamHighlights":285,"testimonials":301,"contentPosts":302,"twitterProfielUrl":9},"Investor","My first taste of entrepreneurship came when I was eight years old, determined to take on Hallmark with a handmade greeting card business. I enlisted my dad to teach me Excel so I could track sales, and while my “startup” didn’t exactly disrupt the industry, it sparked a lasting fascination with how entrepreneurial visions turn into real world impact.\r\n\r\nThat early curiosity led me to study electrical engineering, where I immersed myself in the startup world as an advisor, student VC, and operator—including at IVP portfolio company Clipboard Health. Wanting to deepen my understanding of company building, I joined the technology group at PWP, advising high-growth startups and public companies on M&A. The combination of financial rigor and hands-on startup experience now shapes my work at IVP, where I focus on consumer and application software businesses.\r\n\r\nI’m drawn to founders with strategic ambition, humility, and a track record of execution. The most exciting companies don’t just build products—they redefine the possible, reshape culture, and unlock entirely new markets. ",{"id":8,"alt":9,"caption":10,"assetUrl":11,"assetUrlXs":12,"assetUrlSm":13,"assetUrlMd":14,"assetUrlLg":15,"assetUrlXl":16,"assetUrlXxl":17},"2018","",null,"https://assets.ivp.com/system/uploads/fae/image/asset/2018/IVP_Headshots_1090px_C_Micherice_Tao.jpg","https://assets.ivp.com/