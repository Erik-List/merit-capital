[{"data":1,"prerenderedAt":397},["ShallowReactive",2],{"gql:data:ub6f0dNguERdEFyG8XbmLdxU859irAfWyP5busphoe0":3},{"teamMember":4},{"abbreviatedTitle":5,"bio":6,"image":7,"highlightStatement":9,"companies":18,"derivedSeoDescription":10,"derivedSeoTitle":274,"derivedSocialMediaDescription":10,"derivedSocialMediaImage":10,"derivedSocialMediaTitle":274,"emailAddress":275,"firstName":276,"focusAreas":277,"fullName":278,"fullTitle":5,"introduction":279,"lastName":280,"linkedinProfileUrl":281,"substackProfileUrl":9,"slug":282,"teamHighlights":283,"testimonials":296,"contentPosts":297,"twitterProfielUrl":9},"Partner","Startup founders are irrationally optimistic. They take on huge challenges, persist through rejection, and navigate extreme uncertainty. Without irrational optimism, their companies wouldn’t exist or stand a chance to succeed. As an investor, joining them in that optimism and reaching the point of unwavering belief in their vision is nothing short of a thrill. The real fulfillment, though, comes from partnering deeply with founders through the inevitable highs and lows of turning that vision into reality.\r\n\r\nI grew up in South Florida and went on to study economics and play hockey at Tufts University. After college, I started my career in investment banking, learning more about financial modeling and analysis than I ever wanted to. I then spent a couple of years as a Series A investor, focusing on products, markets, and teams. Now at IVP, I bring together the quantitative skill set I built in banking and qualitative skill set I built in early-stage venture to guide founders and help IVP partner with outstanding companies.\r\n",{"id":8,"alt":9,"caption":10,"assetUrl":11,"assetUrlXs":12,"assetUrlSm":13,"assetUrlMd":14,"assetUrlLg":15,"assetUrlXl":16,"assetUrlXxl":17},"2347","",null,"https://assets.ivp.com/system/uploads/fae/image/asset/2347/IVP_Headshots_1090px_A_Clay_Berger.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2347/xs_IVP_Headshots_10