[{"data":1,"prerenderedAt":67},["ShallowReactive",2],{"gql:data:hCWkwlOZJGxaBNK-5x6_6WUsjGXAOtSTMX1xabvSA-0":3},{"company":4},{"colorFill":5,"transparentLogo":6,"logoBackground":17,"attribution":8,"body":19,"derivedSeoDescription":20,"derivedSeoTitle":21,"derivedSocialMediaDescription":20,"derivedSocialMediaImage":9,"derivedSocialMediaTitle":22,"description":8,"headline":23,"image":24,"introduction":8,"investmentDate":26,"jobLinkUrl":27,"ctaLinkUrl":8,"ctaLinkText":8,"leadership":28,"linkUrl":29,"linkText":30,"linkedinLinkUrl":31,"logo":32,"moments":41,"name":42,"quote":8,"seoDescription":20,"seoTitle":21,"slug":43,"socialMediaDescription":8,"socialMediaImage":44,"socialMediaTitle":22,"status":46,"teamMembers":49,"tileHoverImage":56,"twittterLinkUrl":65,"websiteUrl":66},"#013DA5",{"id":7,"alt":8,"caption":9,"assetUrl":10,"assetUrlXs":11,"assetUrlSm":12,"assetUrlMd":13,"assetUrlLg":14,"assetUrlXl":15,"assetUrlXxl":16},"2420","",null,"https://assets.ivp.com/system/uploads/fae/image/asset/2420/IVP_PortCo_Logos_520px_033126_Aledade.png","https://assets.ivp.com/system/uploads/fae/image/asset/2420/xs_IVP_PortCo_Logos_520px_033126_Aledade.png","https://assets.ivp.com/system/uploads/fae/image/asset/2420/sm_IVP_PortCo_Logos_520px_033126_Aledade.png","https://assets.ivp.com/system/uploads/fae/image/asset/2420/md_IVP_PortCo_Logos_520px_033126_Aledade.png","https://assets.ivp.com/system/uploads/fae/image/asset/2420/lg_IVP_PortCo_Logos_520px_033126_Aledade.png","https://assets.ivp.com/system/uploads/fae/image/asset/2420/xl_IVP_PortCo_Logos_520px_033126_Aledade.png","https://assets.ivp.com/system/uploads/fae/image/asset/2420/xxl_IVP_PortCo_Logos_520px_033126_Aledade.png",{"id":18,"alt":8,"caption":9,"assetUrl":9,"assetUrlXs":9,"assetUrlSm":9,"assetUrlMd":9,"assetUrlLg":9,"assetUrlXl":9,"assetUrlXxl":9},"2421","It’s no secret that the U.S. healthcare system suffers from wasteful spending and suboptimal outcomes. Traditionally, the sicker patients get, the more profitable they become for healthcare providers—a system that has long created misaligned incentives by rewarding the treatment of disease rather than its prevention.\r\n\r\nThrough its proprietary technology platform and local, hands-on support teams, Aledade promotes value-based care programs in which compensation is aligned with quality—as opposed to quantity—of care. By partnering with primary care practices to build and lead Accountable Care Organizations (ACOs), the startup is helping deliver better patient care, improved health for overall populations, and reduced care costs. As beneficial to doctors as it is to patients, Aledade’s model is paving the way for a stronger, healthier healthcare system and society as a whole.","Learn how the Aledade model is helping create a more humane healthcare system by promoting value-based care programs that emphasize quality over quantity.","Aledade - IVP Portfolio - Healthcare Technology Venture Capital","Aledade - IVP Portfolio","Partnering with independent practices, health centers, and clinics to build and lead accountable care",{"id":25,"alt":8,"caption":9,"assetUrl":9,"assetUrlXs":9,"assetUrlSm":9,"assetUrlMd":9,"assetUrlLg":9,"assetUrlXl":9,"assetUrlXxl":9},"111","2021-01-01","https://careers.ivp.com/companydetail.php?cid=14828&v=36","Farzad Mostashari","/content/aledade-improving-data-driven-patient-outcomes/","Read the Funding Announcement","https://www.linkedin.com/company/aledade-inc-/",{"id":33,"alt":8,"caption":9,"assetUrl":34,"assetUrlXs":35,"assetUrlSm":36,"assetUrlMd":37,"assetUrlLg":38,"assetUrlXl":39,"assetUrlXxl":40},"113","https://assets.ivp.com/system/uploads/fae/image/asset/113/Aledade_Logo.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/113/xs_Aledade_Logo.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/113/sm_Aledade_Logo.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/113/md_Aledade_Logo.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/113/lg_Aledade_Logo.jpg","https://as