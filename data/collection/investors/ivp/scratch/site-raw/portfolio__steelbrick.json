[{"data":1,"prerenderedAt":66},["ShallowReactive",2],{"gql:data:6JuW8HWjIhagCbuS1Bk-A_-MmCCpMU7M9H57wZFR6AM":3},{"company":4},{"colorFill":5,"transparentLogo":6,"logoBackground":17,"attribution":8,"body":19,"derivedSeoDescription":20,"derivedSeoTitle":21,"derivedSocialMediaDescription":20,"derivedSocialMediaImage":9,"derivedSocialMediaTitle":22,"description":8,"headline":23,"image":24,"introduction":8,"investmentDate":26,"jobLinkUrl":8,"ctaLinkUrl":8,"ctaLinkText":8,"leadership":27,"linkUrl":28,"linkText":29,"linkedinLinkUrl":8,"logo":30,"moments":8,"name":39,"quote":8,"seoDescription":20,"seoTitle":21,"slug":40,"socialMediaDescription":8,"socialMediaImage":41,"socialMediaTitle":22,"status":43,"teamMembers":46,"tileHoverImage":56,"twittterLinkUrl":8,"websiteUrl":65},"#C92228",{"id":7,"alt":8,"caption":9,"assetUrl":10,"assetUrlXs":11,"assetUrlSm":12,"assetUrlMd":13,"assetUrlLg":14,"assetUrlXl":15,"assetUrlXxl":16},"2295","",null,"https://assets.ivp.com/system/uploads/fae/image/asset/2295/IVP_PortCo_Logos_520px_033126_SteelBrick.png","https://assets.ivp.com/system/uploads/fae/image/asset/2295/xs_IVP_PortCo_Logos_520px_033126_SteelBrick.png","https://assets.ivp.com/system/uploads/fae/image/asset/2295/sm_IVP_PortCo_Logos_520px_033126_SteelBrick.png","https://assets.ivp.com/system/uploads/fae/image/asset/2295/md_IVP_PortCo_Logos_520px_033126_SteelBrick.png","https://assets.ivp.com/system/uploads/fae/image/asset/2295/lg_IVP_PortCo_Logos_520px_033126_SteelBrick.png","https://assets.ivp.com/system/uploads/fae/image/asset/2295/xl_IVP_PortCo_Logos_520px_033126_SteelBrick.png","https://assets.ivp.com/system/uploads/fae/image/asset/2295/xxl_IVP_PortCo_Logos_520px_033126_SteelBrick.png",{"id":18,"alt":8,"caption":9,"assetUrl":9,"assetUrlXs":9,"assetUrlSm":9,"assetUrlMd":9,"assetUrlLg":9,"assetUrlXl":9,"assetUrlXxl":9},"2296","SteelBrick is a software company dedicated to automating the sales process and boosting revenue. Natively built on Salesforce, the world’s leading CRM platform, SteelBrick simplifies and accelerates the sales process by automatically configuring product bundles, pricing and discounting products correctly and generating a standardized quote. Once the configure-price-quote (CPQ) process is complete, SteelBrick seamlessly creates a contract and invoices the client, leading to faster cash collections. The entire quote-to-cash (QTC) process is a critical step between an enterprise’s CRM and its financial accounting or ERP system, and Salesforce recognized the immense value of SteelBrick’s  breakthrough technology early on, moving to acquire it in 2015. We’re proud to be involved in the building of a category-defining, top software company like SteelBrick.","Built on the Salesforce platform, SteelBrick is automating the sales process as a fast-growing provider of next-gen quote-to-cash software applications.","SteelBrick - IVP Portfolio - VC for Fast-Growing Software Companies","SteelBrick - IVP Portfolio ","A fast-growing provider of next-gen quote-to-cash software applications built on the Salesforce platform",{"id":25,"alt":8,"caption":9,"assetUrl":9,"assetUrlXs":9,"assetUrlSm":9,"assetUrlMd":9,"assetUrlLg":9,"assetUrlXl":9,"assetUrlXxl":9},"547","2015-01-01","Godard Abel","/content/the-abcs-of-qtc-why-ivp-invested-in-steelbrick/","Read the Funding Announcement",{"id":31,"alt":8,"caption":9,"assetUrl":32,"assetUrlXs":33,"assetUrlSm":34,"assetUrlMd":35,"assetUrlLg":36,"assetUrlXl":37,"assetUrlXxl":38},"549","https://assets.ivp.com/system/uploads/fae/image/asset/549/Steelbrick.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/549/xs_Steelbrick.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/549/sm_Steelbrick.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/549/md_Steelbrick.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/549/lg_Steelbrick.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/549/xl_Steelbrick.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/549/