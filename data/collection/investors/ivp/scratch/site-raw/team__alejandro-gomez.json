[{"data":1,"prerenderedAt":521},["ShallowReactive",2],{"gql:data:-fgExG1G9PFrnX8pqJeYNCi78mbNJOBqNfTIFAzvCwU":3},{"teamMember":4},{"abbreviatedTitle":5,"bio":6,"image":7,"highlightStatement":9,"companies":18,"derivedSeoDescription":10,"derivedSeoTitle":308,"derivedSocialMediaDescription":10,"derivedSocialMediaImage":10,"derivedSocialMediaTitle":308,"emailAddress":309,"firstName":310,"focusAreas":311,"fullName":312,"fullTitle":5,"introduction":9,"lastName":313,"linkedinProfileUrl":314,"substackProfileUrl":9,"slug":315,"teamHighlights":316,"testimonials":332,"contentPosts":333,"twitterProfielUrl":9},"Investor","I’ve always been driven by the pursuit of knowledge and a curiosity to explore new perspectives. It’s what brought me from Mexico to the U.S. for college, where I pursued my undergrad in engineering, honing my skills in mathematical optimization and systems thinking. However, it wasn’t until my sophomore year at Berkeley, when I joined the student-led investment club, that I uncovered the link between my coursework in optimization and the strategic decisions that drive business success. This newfound passion for investing and approaching businesses with a founder’s mindset complemented my technical background and ultimately led me to venture. For me, working in venture became the ultimate optimization problem: aligning innovative ideas with the right resources to maximize impact and foster sustainable growth.\r\n\r\nWhen working with founders and CEOs, I focus on pragmatism, alignment, and agility. It's about understanding their vision deeply while grounding ideas in actionable steps that suit their resources and their reality. Timing matters, but progress tends to be made through small, consistent wins.  ",{"id":8,"alt":9,"caption":10,"assetUrl":11,"assetUrlXs":12,"assetUrlSm":13,"assetUrlMd":14,"assetUrlLg":15,"assetUrlXl":16,"assetUrlXxl":17},"2334","",null,"https://assets.ivp.com/system/uploads/fae/image/asset/2334/IVP_Headshots_1090px_A_Alejandro_Gomez.jpg