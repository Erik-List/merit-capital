[{"data":1,"prerenderedAt":76},["ShallowReactive",2],{"gql:data:Dvxv6pFKNJDvA59D0Sh05-lPzAxDcYM0_wTZr5wfg-c":3},{"teamMember":4},{"abbreviatedTitle":5,"bio":6,"image":7,"highlightStatement":9,"companies":18,"derivedSeoDescription":10,"derivedSeoTitle":19,"derivedSocialMediaDescription":10,"derivedSocialMediaImage":10,"derivedSocialMediaTitle":19,"emailAddress":20,"firstName":21,"focusAreas":9,"fullName":22,"fullTitle":23,"introduction":24,"lastName":25,"linkedinProfileUrl":26,"substackProfileUrl":9,"slug":27,"teamHighlights":28,"testimonials":44,"contentPosts":45,"twitterProfielUrl":9},"Legal & Compliance","I initially pursued law because it seemed like a career path with endless possibilities. After practicing for a couple years, a recruiter from a venture firm reached out looking for a compliance counsel and I decided to give that possibility a chance. Whether the role would be temporary or not, I knew it would be an incredible growth opportunity. \r\n\r\nIn my current role at IVP, I’m excited by the constant opportunity to help solve new and interesting problems with our investors and portfolio companies alike. Being part of an industry that supports innovation is fulfilling in and of itself, but it’s particularly motivating to get to work through the complex legal issues that bolster transformative companies and ultimately help drive returns. \r\n\r\nOver the course of my career, I’ve learned that keeping an open mind is key: willingness to find creative solutions usually leads to better outcomes and happier clients and colleagues. Instead of presumptively treading the well-worn path, it’s always worth earnestly looking for fresh solutions. ",{"id":8,"alt":9,"caption":10,"assetUrl":11,"assetUrlXs":12,"assetUrlSm":13,"assetUrlMd":14,"assetUrlLg":15,"assetUrlXl":16,"assetUrlXxl":17},"2370","",null,"https://assets.ivp.com/system/uploads/fae/image/asset/2370/IVP_Headshots_1090px_C_Leslie_Stolper.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2370/xs_IVP_Headshots_1090px_C_Leslie_Stolper.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2370/sm_IVP_Headshots_1090px_C_Leslie_Stolper.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2370/md_IVP_Headshots_1090px_C_Leslie_Stolper.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2370/lg_IVP_Headshots_1090px_C_Leslie_Stolper.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2370/xl_IVP_Headshots_1090px_C_Leslie_Stolper.jpg","https://assets.ivp.com/system/uploads/fae/image/asset/2370/xxl_IVP_Headshots_1090px_C_Leslie_Stolper.jpg",[],"Leslie Stolper | Team | IVP","lstolper@ivp.com","Leslie","Leslie Stolper","Head of Legal and Compliance","Helping solve complex legal questions to drive change and support innovation","Stolper","https://www.linkedin.com/in/leslie-schuster-stolper-623a2763/","leslie-stolper",[29,32,35,38,41],{"header":30,"body":31},"Active Obsession","Spending at least 10 minutes a day reading just for fun!",{"header":33,"body":34},"Note to Self","Say “yes” as often as possible. You’ll never know what amazing things are possible if you’re not open to new possibilities.",{"header":36,"body":37},"Proudest Venture","My kids. Their happiness is the best, most joyous part of my life.",{"header":39,"body":40},"Go-To Recipe","Alison Roman’s shallot pasta",{"header":42,"body":43},"My Other Dream Job","I’d love to work at a non-profit that advocates for the rights of women and children. ",[],[46],{"id":47,"date":48,"company":10,"companies":49,"contentCategory":50,"externalLinkUrl":9,"linkType":61,"pdfLinkFile":62,"hideDate":64,"hasDetailPage":10,"slug":65,"tileImage":66,"altHoverImage":10,"landscapeHero":10,"title":75},"200","2024-11-15",[],{"name":51,"contentTopicImage":52},"jumpGuides",{"id":53,"alt":9,"caption":10,"assetUrl":54,"assetUrlXs":55,"assetUrlSm":56,"assetUrlMd":57,"assetUrlLg":58,"assetUrlXl":59,"assetUrlXxl":60},"2404","https://assets.ivp.com/system/uploads/fae/image/asset/2404/IVP_jumpGuide_IndustryInsights_04202