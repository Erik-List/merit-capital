    "parser": "card_blocks",
    "url": "https://lsvp.com/companies/",
    "block_start": "<li data-appear-list ",
    "field_patterns": {
     "site_slug": "data-company-id=\"([^\"]+)\"",
     "investor": "data-investor=\"([^\"]+)\"",
     "url": "<a href=\"([^\"]+)\"",
     "name": "<h5>\\s*([^<]+?)\\s*<",
     "founded": "<strong>Founded</strong>\\s*<span>([^<]*)</span>",
     "stage_invested": "Invested</strong>\\s*<span>([^<]*)</span>",
     "invest_year": "Since</strong>\\s*<span>([^<]*)</span>",
     "status_site": "<strong>Status</strong>\\s*<span>([^<]*)</span>"
    },
    "require": {
     "investor": ["lsvp", "both"]
    },
    "list": "companies-page",
    "fields": {
     "name": "name",
     "url": "url"
    },
    "extras": [
     "investor",
     "founded",
     "stage_invested",
     "invest_year",
     "status_site",
     "site_slug"
    ]
   }
  ]
