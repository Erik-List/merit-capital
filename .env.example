# Copy to .env.local and fill in real values (Supabase dashboard -> Project Settings -> API).

# Supabase project URL (client-safe).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key, public by design; database grants are the access gate (client-safe).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key, bypasses all access control; server-only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
